    def test_checkout_receipt_uses_quote_and_blocks_duplicates_and_downgrade(self):
        with Session(self.engine) as db:
            plan = ServicePlan(code="frozen-checkout", name="Frozen", price=Decimal("999999"))
            db.add(plan)
