DATABASE_URL=postgresql+psycopg://crm_app:CHANGE_ME_use_a_long_random_password@localhost:5432/crm_chatbot
PLATFORM_DATABASE_URL=postgresql+psycopg://crm_app:CHANGE_ME_use_a_long_random_password@localhost:5432/crm_platform
TENANT_DATABASE_URL=postgresql+psycopg://crm_app:CHANGE_ME_use_a_long_random_password@localhost:5432/crm_tenant

# Development is safe for a local clone. Use real random values in production.
ENVIRONMENT=development
AUTH_SECRET=
CHANNEL_ENCRYPTION_KEY=
CHANNEL_ROUTE_SECRET=
SECRET_MANAGER_MODE=env
SECRET_MANAGER_FILE=

FRONTEND_BASE_URL=http://localhost:5173
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS=false
HSTS_ENABLED=false

# Optional channel configuration. Keep real tokens in the private .env only.
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_BRIDGE_CONTROL_URL=http://127.0.0.1:8091
PUBLIC_ORIGIN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_OAUTH_REDIRECT_URI=
ZALO_PERSONAL_BRIDGE_KEY=
ZALO_PERSONAL_BUSINESS_ID=0

CHANNEL_HEALTH_INTERVAL_SECONDS=60

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=memory
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_REQUESTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=180
AUTH_LOGIN_RATE_LIMIT_BACKEND=memory

# OTP is disabled for a local clone. Configure SMTP/Twilio privately when needed.
OTP_DELIVERY_MODE=disabled
OTP_DELIVERY_FALLBACK=disabled
OTP_FROM_EMAIL=
OTP_SMTP_HOST=
OTP_SMTP_PORT=587
OTP_SMTP_USERNAME=
OTP_SMTP_PASSWORD=
OTP_SMTP_USE_TLS=true
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_TWILIO_FROM_NUMBER=

# Leave empty for a local clone. Add provider keys only in a private .env.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_API_KEYS=
GROQ_API_KEY=
GROQ_API_KEYS=
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEYS=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768
API_KEY_COOLDOWN_SECONDS=60
RAG_AUTO_REPLY_ENABLED=true
RAG_AUTO_SEED_ENABLED=true
RAG_AUTO_SEED_FAST_MODE=false
