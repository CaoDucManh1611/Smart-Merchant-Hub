# Compose interpolation values. Replace every CHANGE_ME value privately.
POSTGRES_DB=crm_chatbot
POSTGRES_USER=crm_app
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
DATABASE_URL=postgresql+psycopg://crm_app:CHANGE_ME_use_a_long_random_password@db:5432/crm_chatbot

# payOS checkout is disabled until credentials and HTTPS callback URLs are configured.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
PAYOS_EXPECTED_ACCOUNT_NUMBER=
PAYOS_EXPECTED_BANK_BIN=
PAYOS_PAYMENT_TTL_SECONDS=900
