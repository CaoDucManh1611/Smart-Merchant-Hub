# Values used by docker-compose.production.yml. Copy this to .env.production
# privately, then replace every CHANGE_ME value through the secret manager.
POSTGRES_DB=crm_chatbot
POSTGRES_USER=crm_app
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
FRONTEND_PORT=8080
# Must be one of the public hosts allowed by backend/.env; used only by the
# internal Docker health probe.
HEALTHCHECK_HOST=crm.example.com
