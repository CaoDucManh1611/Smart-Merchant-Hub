DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@localhost:5432/crm_chatbot

# Use long random values in every deployed environment.
ENVIRONMENT=development
AUTH_SECRET=
CHANNEL_ENCRYPTION_KEY=

FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# TikTok Shop webhook verification (keep the secret server-side only).
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# Public origin only (for example https://your-tunnel.ngrok-free.dev), not an
# OAuth callback path. Set META_OAUTH_REDIRECT_URI separately when needed.
PUBLIC_BASE_URL=
FRONTEND_BASE_URL=http://localhost:5173

# API hardening. Use the deployed HTTPS frontend/domain in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS=false
HSTS_ENABLED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=proxy

# OTP delivery: disabled locally; use in_chat only for a free demo.
# For the current rollout use email SMTP (Gmail requires an App Password,
# not the normal account password). SMS/Twilio can be enabled later.
OTP_DELIVERY_MODE=disabled
OTP_DELIVERY_FALLBACK=disabled
# Example email setup:
# OTP_DELIVERY_MODE=smtp
# OTP_FROM_EMAIL=your-shop@gmail.com
# OTP_SMTP_HOST=smtp.gmail.com
# OTP_SMTP_PORT=587
# OTP_SMTP_USERNAME=your-shop@gmail.com
# OTP_SMTP_PASSWORD=16-character-gmail-app-password
# OTP_SMTP_USERNAME must be the mailbox that owns the App Password; do not
# put the regular Gmail password here. Keep OTP_FROM_EMAIL on the same mailbox
# unless the provider explicitly authorizes a different sender.
OTP_FROM_EMAIL=
OTP_SMTP_HOST=
OTP_SMTP_PORT=587
OTP_SMTP_USERNAME=
OTP_SMTP_PASSWORD=
OTP_SMTP_USE_TLS=true
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_TWILIO_FROM_NUMBER=

LLM_PROVIDER=groq
LLM_API_KEY=
# Production rotation pool: key-1,key-2,key-3,key-4,key-5
LLM_API_KEYS=
GROQ_API_KEY=
# Configure five provider keys in production, separated by commas.
GROQ_API_KEYS=
API_KEY_COOLDOWN_SECONDS=60
LLM_MODEL=openai/gpt-oss-20b

# Local embedding does not require a cloud API key.
EMBEDDING_PROVIDER=local
# Cloud embedding rotation pool (when EMBEDDING_PROVIDER is gemini/openai).
EMBEDDING_API_KEYS=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768

RAG_AUTO_REPLY_ENABLED=true
RAG_AUTO_SEED_ENABLED=true
RAG_AUTO_SEED_FAST_MODE=false
